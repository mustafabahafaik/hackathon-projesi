STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Example: the current testnet deploy (see docs/submission.md for the tx
# links and smoke-test proof). Redeploy with scripts/deploy-testnet.sh and
# update this if you need your own instance.
ESCROW_CONTRACT_ID=CBA4FFYLQAMOC5JAHATW3YK67OZQN3KQC2KACXZCB66T6Q5LHQ5VERXQ
# Real testnet DeFindex USDC vault (Paltalabs), confirmed live with
# `stellar contract info interface --id ... --network testnet` — see
# contracts/escrow/src/vault.rs and docs/submission.md. Verify against
# https://github.com/defindex-io/stellar-contracts/blob/main/public/testnet.contracts.json
# before relying on it — testnet redeploys.
DEFINDEX_VAULT_ADDRESS=CBMVK2JK6NTOT2O4HNQAIQFJY232BHKGLIMXDVQVHIIZKDACXDFZDWHN
# Real testnet Soroswap router — confirmed live with `stellar contract info
# interface --id ... --network testnet`, and confirmed to have real,
# liquid pools (e.g. XLM/USDC) via the factory contract's `all_pairs` /
# `get_pair`. Used directly (not via api.soroswap.finance) by
# apps/api/src/services/escrow-orchestrator/soroswap.ts — see that file's
# module doc for why. Verify against
# https://github.com/soroswap/core/blob/main/public/testnet.contracts.json
# before relying on it — testnet redeploys.
SOROSWAP_ROUTER_ADDRESS=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD
# Not in CLAUDE.md's original list — added in Phase 1.2 because deposit()
# needs to know which SEP-41 token contract to pull from the tenant. Must
# be the exact asset DEFINDEX_VAULT_ADDRESS holds (its deposit() rejects
# anything else) — this is that vault's real testnet USDC, confirmed via
# its own get_assets() call. See docs/submission.md.
USDC_TOKEN_ADDRESS=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
# Classic-asset issuer for the credit_alphanum4 "USDC" apps/anchor-stub
# pays out / accepts on Stellar testnet — distinct from USDC_TOKEN_ADDRESS
# above (that's the Soroban SAC address DeFindex/Soroswap use for the same
# underlying asset). If no real testnet TRY anchor turns up, mint/issue
# your own testnet USDC-like asset from ANCHOR_SIGNING_SECRET's account and
# put its issuer here.
USDC_ISSUER=
HORIZON_URL=https://horizon-testnet.stellar.org
# Points apps/api's anchor-integration service at whichever anchor to
# drive: leave unset to use the local apps/anchor-stub (default
# http://localhost:4001, see ANCHOR_PORT/ANCHOR_BASE_URL below), or set to
# a real testnet TRY anchor's home domain once Workshop #3 confirms one
# (CLAUDE.md "Anchor Riski") — no code change needed, endpoints are
# discovered from that domain's SEP-1 stellar.toml either way.
ANCHOR_HOME_DOMAIN=
# apps/anchor-stub's own listen config — only relevant when running the
# stub (i.e. ANCHOR_HOME_DOMAIN unset or pointed at it).
ANCHOR_PORT=4001
ANCHOR_BASE_URL=http://localhost:4001
# Funded testnet account the stub signs SEP-10 challenges with and pays
# deposits from — needs a testnet XLM balance (friendbot) and a trustline
# + real balance in the USDC_ISSUER asset above to pay out real deposits.
ANCHOR_SIGNING_SECRET=
# Symmetric secret for the stub's SEP-10 session JWTs. Stub-only; a real
# anchor manages its own.
ANCHOR_JWT_SECRET=
# Simulated TRY-per-USDC rate — the one deliberately fake number in the
# whole anchor stub; every Stellar-side effect it drives is real. See
# apps/anchor-stub/src/config.ts.
ANCHOR_FX_RATE_TRY_PER_USDC=34.5
# apps/api's own listen config, and the base URL the anchor's SEP-24
# webhook is told to call back into (must be reachable from the anchor —
# localhost works when anchor-stub and api run on the same machine).
API_PORT=4000
API_BASE_URL=http://localhost:4000
PRIVY_APP_ID=
PRIVY_APP_SECRET=
DATABASE_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Client-side (apps/web)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
